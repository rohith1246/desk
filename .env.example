# Vitoniya Public Help Desk - Environment Configuration
# Target Subdomain: desk.vitoniya.com

# Database URL: Supports PostgreSQL Neon Cloud, or leave blank to fall back to SQLite
DATABASE_URL=postgresql://username:password@ep-your-neon-cluster.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Multilingual Vision & Voice Pre-Screening)
GEMINI_API_KEY=your_google_gemini_api_key

# Groq API Key (High-Speed Fallback)
GROQ_API_KEY=your_groq_api_key

# Port Configuration
PORT=5050
HOST=0.0.0.0
